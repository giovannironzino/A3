rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 128 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 128)) &&
             (!('clinicName' in data) || (data.clinicName is string && data.clinicName.size() <= 128));
    }

    function isValidA3Answer(data) {
      return data.keys().hasAll(['questionId', 'savedAt', 'userId']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.questionId is string && data.questionId.size() <= 128 &&
             data.savedAt is string && data.savedAt.size() <= 64 &&
             (!('isEstimate' in data) || data.isEstimate is bool) &&
             (!('value' in data) || (data.value is string && data.value.size() <= 1000));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;

      // Subcollection for A3 Answers
      match /a3_answers/{answerId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidA3Answer(incoming());
        allow update: if isOwner(userId) && isValidA3Answer(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
